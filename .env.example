# My Life Hub — reference values (NOT read by the app at runtime).
# The app is a static index.html; the live API URL is hard-coded as API_URL in index.html.
# Keep the real values in a local .env (git-ignored) so Claude Code knows where things live.

# GitHub Pages
GITHUB_USER=netflixhafiz97
GITHUB_REPO=life-hub
SITE_URL=https://netflixhafiz97.github.io/life-hub/

# Google Sheet "My Life Hub" (the database)
SHEET_ID=PASTE_SHEET_ID_HERE

# Apps Script project bound to the sheet ("My Life Hub API")
SCRIPT_ID=PASTE_APPS_SCRIPT_PROJECT_ID_HERE

# Web app deployment (Manage deployments > Edit > New version keeps this ID)
DEPLOYMENT_ID=PASTE_DEPLOYMENT_ID_HERE
API_URL=https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID_HERE/exec

# PIN: stored server-side in the Sheet tab "Settings" (key=pin).
# The client keeps only PIN_HASH (SHA-256) in index.html for offline unlock.
# Never commit the real PIN.
APP_PIN=XXXX
